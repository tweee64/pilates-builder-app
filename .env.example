# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret
AUTH_SECRET=""

# Canonical site URL for OAuth callbacks. Local dev can omit this; in
# production set it to the live HTTPS URL (e.g. https://spine.vercel.app).
AUTH_URL=""

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback URL: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Drizzle / Postgres (Neon in production)
DATABASE_URL="postgresql://postgres:password@localhost:5432/spine"
