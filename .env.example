# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret
AUTH_SECRET=""

# Canonical site URL for OAuth callbacks. Local dev can omit this; in
# production set it to the live HTTPS URL (e.g. https://spine.vercel.app).
AUTH_URL=""

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Callback URL: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Drizzle / Postgres (Neon in production)
DATABASE_URL="postgresql://postgres:password@localhost:5432/spine"

# Stripe (MONETIZATION-001) — https://dashboard.stripe.com/test/apikeys
# Optional: billing features fail closed (report an error) when unset.
STRIPE_SECRET_KEY=""
# https://dashboard.stripe.com/test/webhooks — needed to verify the
# `stripe-signature` header on /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Price IDs for the Pro plan's recurring Prices (test mode) —
# https://dashboard.stripe.com/test/products
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_ANNUAL=""

# Upstash Redis (LAUNCH-001) — https://console.upstash.com/
# Optional: rate limiting fails open (allows requests) when unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (LAUNCH-001) — https://sentry.io/
# Optional: error monitoring is disabled (SDK init skipped) when unset.
# NEXT_PUBLIC_SENTRY_DSN is the same DSN, exposed to the browser bundle.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Auth token for uploading source maps during `next build` (CI/Vercel only,
# not read at runtime) — https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=""

