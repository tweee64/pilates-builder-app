# macOS
.DS_Store

# Proprietary/confidential reference material (do not commit)
*.pdf

# Claude Code session/agent state (but keep project skills tracked)
.claude/*
!.claude/skills/

# Env files (spine/.gitignore also covers the app subtree)
.env
.env*.local
.env.production

# Node / build artifacts (belt-and-suspenders; spine/.gitignore covers these too)
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo

# Playwright MCP browser-tool scratch output (snapshots/screenshots/logs)
.playwright-mcp/
